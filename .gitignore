# Binaries for programs and plugins
*.exe
*.exe~
*.dll
*.so
*.dylib
bin/*

# Test binary, build with `go test -c`
*.test

# Output of the go coverage tool, specifically when used with LiteIDE
*.out

# go mod vendor
vendor

# GoLand
.idea/*

# macOS file
.DS_Store

# Python bytecode
**/__pycache__/
*.py[cod]

# Local agent state and dependency caches
.mimosa/
rust/.mimosa/
rust/.cargo-home*/

# Raw diagnostic output is reproducible from the checked-in summaries/scripts.
diagnostics/**/*.log
diagnostics/**/pe-imports.txt
diagnostics/**/*.dat

# Local dependency caches
/.gomodcache/
/.gocache/

# test suite
test/config/cache*
/output
.vscode/
.fleet/
/rust/target
/rust/target-docker-*
/rust/target-ci-*
/rust/.nextest/
/rust/coverage/
/rust/tarpaulin-report/
*.profraw
*.profdata
*.gcda
*.gcno
*.stderr
*.stdout
/.toolchain/
